# Base URL for the Campus Connect API (read by src/lib/api/client.ts and the hooks)
# Must match the API prefix; default backend listens on port 3000 under /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Optional: seed a JWT for local testing when auth storage is not yet wired
# NEXT_PUBLIC_MOCK_TOKEN=your-jwt-token
